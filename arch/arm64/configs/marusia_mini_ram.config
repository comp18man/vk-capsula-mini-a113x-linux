# Help: rescue build, rootfs linked into the Image (RAM only)
#
# Merged onto marusia_mini_defconfig. CONFIG_INITRAMFS_SOURCE is relative to the source root.

CONFIG_INITRAMFS_SOURCE="initramfs.cpio"

# Not duplicates of the defconfig: the flash build has these modular, and an
# initramfs has no root filesystem to read modules or firmware from.
CONFIG_CFG80211=y
CONFIG_W1_AML=y
CONFIG_EXTRA_FIRMWARE="aml/aml_wifi_rf_fn_link.txt aml/aml_wifi_rf.txt eq_8918.bin"
